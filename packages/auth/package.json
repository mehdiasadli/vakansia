{
  "name": "@vakansia/auth",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "generate": "dotenv -e ../../apps/server/.env -- bun x @better-auth/cli generate --config=./src/index.ts --output=../db/prisma/schema/auth.preview.prisma"
  },
  "dependencies": {
    "@vakansia/app": "workspace:*",
    "@better-auth/expo": "catalog:auth",
    "@better-auth/passkey": "catalog:auth",
    "@better-auth/oauth-provider": "catalog:auth",
    "@vakansia/db": "workspace:*",
    "@vakansia/env": "workspace:*",
    "better-auth": "catalog:auth",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@vakansia/config": "workspace:*",
    "dotenv-cli": "^11.0.0",
    "typescript": "catalog:"
  }
}
