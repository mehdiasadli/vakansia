model TwoFactor {
  id          String    @id @default(uuid())
  secret      String
  backupCodes String
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}
