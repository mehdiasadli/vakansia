model Organization {
  id          String       @id @default(uuid())
  name        String
  slug        String
  logo        String?
  metadata    String?
  members     Member[]
  invitations Invitation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@unique([slug])
  @@map("organization")
}
