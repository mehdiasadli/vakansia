enum UserRole {
  user // default role
  moderator // moderator of the platform
  admin // admin of the platform
  owner // owner of the platform
}

model User {
  id                  String              @id @default(uuid())
  /// @zod.min(1, "models.user.fields.name.validation.min").max(50, "models.user.fields.name.validation.max")
  name                String
  /// @zod.email("models.user.fields.email.validation.email")
  email               String
  emailVerified       Boolean             @default(false)
  /// @zod.url("models.user.fields.image.validation.url")
  image               String?
  twoFactorEnabled    Boolean?            @default(false)
  /// @zod.string("models.user.fields.phoneNumber.validation.regex")
  phoneNumber         String?
  phoneNumberVerified Boolean?
  role                UserRole            @default(user)
  banned              Boolean?            @default(false)
  /// @zod.string("models.user.fields.banReason.validation.string").max(255, "models.user.fields.banReason.validation.max")
  banReason           String?
  banExpires          DateTime?
  username            String
  sessions            Session[]
  accounts            Account[]
  twofactors          TwoFactor[]
  passkeys            Passkey[]
  apikeys             Apikey[]
  members             Member[]
  invitations         Invitation[]
  oauthclients        OauthClient[]
  oauthrefreshtokens  OauthRefreshToken[]
  oauthaccesstokens   OauthAccessToken[]
  oauthconsents       OauthConsent[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  deletedAt           DateTime?

  @@unique([email])
  @@unique([phoneNumber])
  @@unique([username])
  @@map("user")
}
