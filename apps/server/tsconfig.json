{
	"extends": "@vakansia/config/tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		"outDir": "dist",
		"rootDir": "src",
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"]
		},
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx",
		"strictNullChecks": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
}
